# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (local or MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/todo_app
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/todo_app
MONGO_URI=

# Port for the Express server (5000 is taken by AirPlay on macOS, so 5050 is used)
PORT=5050

# Address of the React frontend allowed by CORS
CLIENT_URL=http://localhost:3000
